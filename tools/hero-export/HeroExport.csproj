<Project Sdk="Microsoft.NET.Sdk">
  <!-- Exports a Deadlock hero's model, textures and animations from the player's own Deadlock install
       to a local .glb (never committed). Usage is in Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hero-export</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ValveResourceFormat" Version="20.0.6980" />
  </ItemGroup>
</Project>
