# Build output
bin/
obj/
build/
.gradle/
run/
out/
*.class

# IDEs
.idea/
.vs/
.vscode/
*.iml
*.user

# Valve assets are never committed. Paths to them live in config.
assets-local/
*.vpk
*.vmdl
*.vmdl_c
*.vmat
*.vmat_c
*.vtex
*.vtex_c
*.vmap
*.vmap_c
*.vpcf_c

# Local machine config
local.props
*.local.json

# Downloaded Deadworks releases (tools/get-deadworks.ps1)
.deadworks/

# Converted courses are generated from the .nbt by tools/nbt-to-colliders.py
courses/*.json

# Our own Hammer map sources are committed; compiled maps are not.
!maps/*.vmap

# Fabric/Gradle
fabric-client/.gradle/
fabric-client/run/
fabric-client/build/
protocol/java/.gradle/
protocol/java/build/
